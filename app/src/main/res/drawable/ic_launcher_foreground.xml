<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ======================================================== -->
    <!-- Modern Minimalist Typographic Monogram: JB              -->
    <!-- Strictly within 66dp Safe Zone (Center: 54, 54)          -->
    <!-- ======================================================== -->

    <!-- LETTER B (Vibrant Indigo Gradient) -->
    <!-- B Vertical Spine -->
    <path
        android:pathData="M55,34 L55,74"
        android:strokeWidth="5.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="55"
                android:startY="34"
                android:endX="77"
                android:endY="74"
                android:type="linear">
                <item android:color="#FFA5B4FC" android:offset="0.0" />
                <item android:color="#FF818CF8" android:offset="0.5" />
                <item android:color="#FF6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- B Upper Bowl -->
    <path
        android:pathData="M55,34 L65,34 C74,34 74,54 65,54 L55,54"
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="55"
                android:startY="34"
                android:endX="74"
                android:endY="54"
                android:type="linear">
                <item android:color="#FFA5B4FC" android:offset="0.0" />
                <item android:color="#FF818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- B Lower Bowl -->
    <path
        android:pathData="M55,54 L67,54 C77,54 77,74 67,74 L55,74"
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="55"
                android:startY="54"
                android:endX="77"
                android:endY="74"
                android:type="linear">
                <item android:color="#FF818CF8" android:offset="0.0" />
                <item android:color="#FF6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Middle Intertwining Bridge from B into J -->
    <path
        android:pathData="M55,54 L43,54"
        android:strokeWidth="5.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="55"
                android:startY="54"
                android:endX="43"
                android:endY="54"
                android:type="linear">
                <item android:color="#FF818CF8" android:offset="0.0" />
                <item android:color="#FFA5B4FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- LETTER J (High-Contrast Brilliant White) -->
    <!-- Top Bar of J Connecting with B at Cap-Height -->
    <path
        android:pathData="M35,34 L55,34"
        android:strokeWidth="5.6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- J Vertical Stem -->
    <path
        android:pathData="M43,34 L43,63"
        android:strokeWidth="5.6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- J Bottom Hook -->
    <path
        android:pathData="M43,63 C43,74 31,74 31,65"
        android:strokeWidth="5.6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

</vector>

